{
  "name": "unity-game-language-changer",
  "productName": "Unity Game Language Changer",
  "version": "1.0.0",
  "description": "Translate any Unity game into your language with BepInEx and XUnity.AutoTranslator",
  "author": "Unity Game Language Changer",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:ui": "tsc --noEmit && vite build",
    "start": "npm run build:ui && electron .",
    "dist": "npm run build:ui && electron-builder --win portable",
    "format": "prettier --write src electron"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "adm-zip": "^0.6.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tabler/icons-react": "^3.48.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "flag-icons": "^7.5.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.2"
  },
  "build": {
    "appId": "com.ugl.languagechanger",
    "productName": "Unity Game Language Changer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "compression": "maximum",
    "asarUnpack": [
      "node_modules/7zip-bin/win/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "UnityGameLanguageChanger-${version}.exe"
    }
  }
}
